{
  // The main tsconfig only includes src/, so the Playwright suite and its
  // config would otherwise never be type-checked. Same reasoning as
  // tsconfig.server.json (docs/15-quality-and-testing.md).
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["e2e/**/*.ts", "playwright.config.ts"]
}
